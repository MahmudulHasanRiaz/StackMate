# StackMate local configuration template.
# Never put real credentials in this file or commit populated local env files.

# Runtime
APP_ENV=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# PostgreSQL / Neon (Direct connection used only by local dev and migration CLI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stackmate
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/stackmate

# Cloudflare Hyperdrive local connection strings (used by wrangler dev)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_NO_CACHE=postgresql://postgres:postgres@localhost:5432/stackmate
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED=postgresql://postgres:postgres@localhost:5432/stackmate

# Authentication (Better Auth)
BETTER_AUTH_SECRET=replace-with-at-least-32-byte-cryptographic-random-secret
BETTER_AUTH_URL=http://localhost:8787
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8787

# Cryptographic Key Material (Worker Secrets in staging/production)
# Master key for AES-256-GCM envelope encryption of stored secrets (base64url 32 bytes)
ENCRYPTION_KEY_V1=
# First-admin setup token: operator-set secret gating POST /api/auth/bootstrap-super-admin.
# Generate a fresh long random value (at least 32 chars) and set it as the Worker secret
# SETUP_TOKEN in the Cloudflare dashboard (staging/production). When unset, the bootstrap
# endpoint is disabled entirely (404). Never commit a real value here.
SETUP_TOKEN=
ACTIVE_ENCRYPTION_KEY_VERSION=v1
# Keyed HMAC verifier secret for license key hashing and checkout tokens
LICENSE_VERIFIER_SECRET=
CHECKOUT_TOKEN_SECRET=
# Ed25519 JWK private/public key pair for signing offline-verifiable entitlement JWS tokens
LICENSE_SIGNING_PRIVATE_JWK=
LICENSE_SIGNING_PUBLIC_JWK=
LICENSE_SIGNING_KEY_ID=sm-ed25519-2026-11

# Cloudflare R2 (local/dev binding configuration is defined in apps/api/wrangler.jsonc)
R2_BUCKET_NAME=stackmate-private-assets

# External providers — configure only when enabling live provider delivery
META_GRAPH_API_VERSION=v21.0
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
