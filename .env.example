# StackMate local configuration template.
# Never put real credentials in this file or commit populated local env files.

# Runtime
APP_ENV=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# PostgreSQL / Neon
DATABASE_URL=

# Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Cloudflare R2 (local/dev binding configuration is defined in Wrangler)
R2_BUCKET_NAME=

# External providers — configure only when implementing the related integration
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
EMAIL_PROVIDER_API_KEY=
