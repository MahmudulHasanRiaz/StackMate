{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stackmate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "production",
    "DEFAULT_TIMEZONE": "Asia/Dhaka",
    "DEFAULT_CURRENCY": "BDT",
    // F-07: v3 is the active envelope (env.ts default is v3 too) —
    // new encryptions mint v3; v2 rows still decrypt (dual-path).
    "ACTIVE_ENCRYPTION_KEY_VERSION": "v3",
    "LICENSE_SIGNING_KEY_ID": "sm-ed25519-2026-11",
    "META_GRAPH_API_VERSION": "v21.0"
  },
  // Cloudflare Hyperdrive bindings (ADR-0005):
  // 1. HYPERDRIVE_NO_CACHE: created with `--caching-disabled` for auth, sessions, RBAC,
  //    orders, manual payment verification, subscriptions, licenses, and outbox writes/reads.
  // 2. HYPERDRIVE_CACHED: query caching enabled (max_age=60s, swr=15s) strictly for
  //    staleness-tolerant public catalog reads and historical analytics summaries.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_NO_CACHE",
      "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_NO_CACHE_ID",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/stackmate"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_CACHED_ID",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/stackmate"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "stackmate-private-assets",
      "preview_bucket_name": "stackmate-private-assets-preview"
    }
  ],
  // Staging environment (2026-11-15, commerciansbd account): Worker
  // `stackmate-api-staging` bound to the STAGING Neon branch via the two
  // Hyperdrive configs created for staging (never production). The admin
  // SPA is served from this same Worker (static assets) so its relative
  // `/api/v1/...` calls and Better Auth cookies stay same-origin; there
  // is no separate staging Pages project. Secrets (BETTER_AUTH_SECRET,
  // ENCRYPTION_KEY_V1, LICENSE_VERIFIER_SECRET, CHECKOUT_TOKEN_SECRET,
  // SETUP_TOKEN) are set on the Worker in the Cloudflare dashboard,
  // never in this file. SETUP_TOKEN is the operator-set secret gating
  // POST /api/auth/bootstrap-super-admin: when unset the endpoint is
  // disabled (404); see apps/api/src/app.ts.
  // The four staging URL vars below (BETTER_AUTH_URL, API_URL,
  // APP_URL, TRUSTED_ORIGINS) live HERE, in env.staging.vars — NOT
  // only in the dashboard. Dashboard-set plain vars are WIPED by
  // every Git-build deploy (observed 2026-11-16: build 1544e07f
  // reverted the Worker from 15 vars back to 11, dropping all four;
  // they had to be re-added by hand). They are plain URLs, not
  // secrets, so committing them is safe. Production gets NO URL vars
  // here — its URL is unknown; never invent one.
  // Hyperdrive IDs (verified 2026-11-15):
  //   NO_CACHE: 30a29917780c4aff91b9a198b63eb387 (caching disabled)
  //   CACHED:   3ae1e99fbd6d4fcea9a0cb35de71ae4c (max_age 60s, swr 15s)
  "env": {
    "staging": {
      "name": "stackmate-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "DEFAULT_TIMEZONE": "Asia/Dhaka",
        "DEFAULT_CURRENCY": "BDT",
        // F-07: v3 is the active envelope (env.ts default is v3 too).
        "ACTIVE_ENCRYPTION_KEY_VERSION": "v3",
        "LICENSE_SIGNING_KEY_ID": "sm-ed25519-2026-11",
        "META_GRAPH_API_VERSION": "v21.0",
        // Staging URL vars (ADR-0008 decision 10): plain Worker URL,
        // durable here because dashboard-set plain vars are wiped by
        // every Git-build deploy. All four name the same origin;
        // any one suffices for Better Auth's origin check, all four
        // is belt-and-braces against a stale single var.
        "BETTER_AUTH_URL": "https://stackmate-api-staging.ad-dawah.workers.dev",
        "API_URL": "https://stackmate-api-staging.ad-dawah.workers.dev",
        "APP_URL": "https://stackmate-api-staging.ad-dawah.workers.dev",
        "TRUSTED_ORIGINS": "https://stackmate-api-staging.ad-dawah.workers.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_NO_CACHE",
          "id": "9bf5dd1e18da462c86fb42a94a9b6e5f"
        },
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "3ae1e99fbd6d4fcea9a0cb35de71ae4c"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "stackmate-private-assets",
          "preview_bucket_name": "stackmate-private-assets-preview"
        }
      ],
      "assets": {
        "directory": "../../apps/admin/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      }
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
